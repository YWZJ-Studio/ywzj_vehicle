{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vehicle Data Configuration",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "generic",
        "ywzj_vehicle:wheeled_vehicle",
        "ywzj_vehicle:tracked_vehicle",
        "ywzj_vehicle:rotary_wing_vehicle",
        "ywzj_vehicle:fixed_wing_vehicle"
      ],
      "description": "vehicle.type"
    },
    "attributes": {
      "type": "object",
      "description": "vehicle.attributes",
      "properties": {
        "brake_force": {
          "type": "number",
          "minimum": 0,
          "default": 0.015,
          "description": "vehicle.brake_force"
        },
        "forward_force": {
          "type": "number",
          "minimum": 0,
          "default": 0.015,
          "description": "vehicle.forward_force"
        },
        "backward_force": {
          "type": "number",
          "minimum": 0,
          "default": 0.01,
          "description": "vehicle.backward_force"
        },
        "max_speed_forward": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "vehicle.max_speed_forward"
        },
        "max_speed_backward": {
          "type": "number",
          "minimum": 0,
          "default": 0.2,
          "description": "vehicle.max_speed_backward"
        },
        "turn_step": {
          "type": "number",
          "minimum": 0,
          "default": 2.5,
          "description": "vehicle.turn_step"
        },
        "max_turn": {
          "type": "number",
          "minimum": 0,
          "default": 5.0,
          "description": "vehicle.max_turn"
        }
      }
    },
    "max_health": {
      "type": "number",
      "minimum": 1,
      "default": 100,
      "description": "vehicle.max_health"
    },
    "view_info": {
      "type": "object",
      "description": "vehicle.view_info",
      "properties": {
        "third_person_center_offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 0, 0],
          "description": "vehicle.third_person_center_offset"
        },
        "third_person_distance": {
          "type": "number",
          "minimum": 0,
          "default": 8.0,
          "description": "vehicle.third_person_distance"
        },
        "sound_distance": {
          "type": "number",
          "minimum": 0,
          "default": 5.0,
          "description": "vehicle.sound_distance"
        },
        "lock_passenger_y_body_rot": {
          "type": "boolean",
          "default": true,
          "description": "vehicle.lock_passenger_y_body_rot"
        }
      }
    },
    "energy_info": {
      "type": "object",
      "description": "vehicle.energy_info",
      "properties": {
        "energy_capacity": {
          "type": "number",
          "minimum": 0,
          "default": 100.0,
          "description": "vehicle.energy_capacity"
        },
        "energy_consumption_per_tick": {
          "type": "number",
          "minimum": 0,
          "default": 0.01,
          "description": "vehicle.energy_consumption_per_tick"
        }
      }
    },
    "physics_info": {
      "type": "object",
      "description": "vehicle.physics_info",
      "properties": {
        "gravity": {
          "type": "number",
          "default": -0.08,
          "description": "vehicle.gravity"
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05,
          "description": "vehicle.drag"
        }
      }
    },
    "defense_stats": {
      "type": "object",
      "description": "vehicle.defense_stats",
      "properties": {
        "armor": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "vehicle.armor"
        },
        "armor_toughness": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "vehicle.armor_toughness"
        }
      }
    },
    "with_warning_receiver": {
      "type": "boolean",
      "default": false,
      "description": "vehicle.with_warning_receiver"
    },
    "protect_passenger": {
      "type": "boolean",
      "default": true,
      "description": "vehicle.protect_passenger"
    },
    "structure_model": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_/]+$",
      "description": "vehicle.structure_model"
    },
    "parts": {
      "type": "array",
      "description": "vehicle.parts",
      "items": {
        "$ref": "#/definitions/partUnit"
      },
      "default": []
    }
  },
  "definitions": {
    "partUnit": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "vehicle.part_id"
        },
        "name": {
          "type": "string",
          "description": "vehicle.part_name"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9_]+:[a-z0-9_]+$",
          "description": "vehicle.part_type"
        },
        "is_seat": {
          "type": "boolean",
          "default": false,
          "description": "vehicle.is_seat"
        },
        "seat_offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "vehicle.seat_offset"
        },
        "owner_view_offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "vehicle.owner_view_offset"
        },
        "sub_part_unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "vehicle.sub_part_unit_ids"
        }
      }
    }
  }
}
