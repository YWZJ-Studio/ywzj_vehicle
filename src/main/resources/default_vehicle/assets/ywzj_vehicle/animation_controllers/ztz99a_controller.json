          "inputs": [
            {
              // 骨骼绑定 pose
              "type": "bone_binding",
              "special_bindings": [
                {
                  "bones": [
                    "hull_big_0", "hull_big_1", "hull_big_2", "hull_big_3", "hull_big_4",
                    "hull_big_5", "hull_big_6", "hull_big_7", "hull_big_8", "hull_big_9"
                  ],
                  "source": "left_wheel_rotation",
                  "axis": "x",
                  "param": 0.375
                },
                {
                  "bones": ["hull_big_10", "hull_big_11", "hull_big_12"],
                  "source": "right_wheel_rotation",
                  "axis": "x",
                  "param": 0.375
                },
                {
                  "bones": ["hull_small_0", "hull_small_1", "hull_small_2", "hull_small_3", "hull_small_4"],
                  "source": "left_wheel_rotation",
                  "axis": "x",
                  "param": 0.28
                }
              ],
              // 常规的绑定
              "part_bindings": [
                {
                  "bone": "turret",
                  "part": "turret",
                  "rotation_type": "y",
                  "axis": "y",
                  "invert": true
                },
                {
                  "bone": "canno",
                  "part": "turret",
                  "rotation_type": "x",
                  "axis": "x",
                  "invert": false
                },
                {
                  "bone": "machine_gun",
                  "part": "commander_machine_gun",
                  "rotation_type": "y",
                  "axis": "y",
                  "invert": true
                },
                {
                  "bone": "machine_gun_high",
                  "part": "commander_machine_gun",
                  "rotation_type": "x",
                  "axis": "x",
                  "invert": false
                }
              ]
            },
            {
              // 履带动画 pose，仅履带载具有效
              "type": "track_animation"
            }
          ]
        },
        "add": {
          "type": "event_animation"
        }
      }
    ]
  }
