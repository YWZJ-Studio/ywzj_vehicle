{
  "name": "hiace_controller",
  "script": "ywzj_vehicle:hiace",
  "parameters": {},
  "switchable_animations": {
    "front_door_left": {
      "part_id": "front_door_left",
      "animation": "front_door_left"
    },
    "front_door_right": {
      "part_id": "front_door_right",
      "animation": "front_door_right"
    },
    "side_door_left": {
      "part_id": "side_door_left",
      "animation": "side_door_left"
    },
    "side_door_right": {
      "part_id": "side_door_right",
      "animation": "side_door_right"
    }
  },
  "graph": {
