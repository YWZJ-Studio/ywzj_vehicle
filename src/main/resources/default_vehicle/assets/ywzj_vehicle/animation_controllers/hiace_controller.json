            "min": -30.0,
            "max": 30.0
          },
          {
            "bones": ["control"],
            "source": "steering_angle",
            "axis": "y",
            "multiplier": 12
          }
        ]
      },
      {
        "type": "switchable_animation",
        "ref": "front_door_left"
      },
      {
        "type": "switchable_animation",
        "ref": "front_door_right"
      },
      {
        "type": "switchable_animation",
        "ref": "side_door_left"
      },
      {
        "type": "switchable_animation",
        "ref": "side_door_right"
      }
    ]
